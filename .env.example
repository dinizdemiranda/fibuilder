# Used only server-side (src/routes/api/assistant/+server.js) — never sent to
# the browser. Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Gates the entire app behind HTTP Basic Auth (src/hooks.server.js) — a
# single shared password, checked on every request. REQUIRED before a public
# deploy: without it, /api/assistant is a free unauthenticated proxy to your
# OpenAI key. Any username works; only this password is checked.
SITE_PASSWORD=
